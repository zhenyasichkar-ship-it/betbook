# Pooled Neon Postgres URL, with TLS settings from the provider.
DATABASE_URL=

# Server-only. Set in Vercel for production.
TELEGRAM_BOT_TOKEN=

# Числові Telegram ID адміністраторів через кому.
ADMIN_TELEGRAM_IDS=

# Опційно. Публічна HTTPS-адреса для підключення Telegram-вебхука.
BETBOOK_WEBHOOK_ORIGIN=

# Optional. Only enables a test identity under npm run dev.
BETBOOK_LOCAL_DEMO=0
